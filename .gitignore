# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & IDEs
venv/
.venv/
env/
.env
.vscode/
.idea/

# Large Datasets, CSVs, and JSONs in data directories
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.json

# Keep gitkeep files tracked
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints & serialized artifacts
models/*.pkl
models/*.h5
models/*.pt

# Archives & OS Metadata
*.tar.gz
*.zip
.DS_Store
Thumbs.db
*.log
*.tmp
.pytest_cache/
.ipynb_checkpoints/

# Keep gitkeep files tracked
!models/.gitkeep
!notebooks/.gitkeep
!reports/.gitkeep
!docs/.gitkeep
