# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & IDEs
venv/
.venv/
env/
.env
.vscode/
.idea/

# Large Datasets in data directories (except deployment phase4 predictions)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.json

!data/processed/phase4_predictions.csv
!data/processed/live_events.jsonl
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints & serialized artifacts tracked for deployment
!models/*.pkl
!models/*.h5
!models/*.pt

# Archives & OS Metadata
*.tar.gz
*.zip
.DS_Store
Thumbs.db
*.log
*.tmp
.pytest_cache/
.ipynb_checkpoints/

# Keep gitkeep files tracked
!models/.gitkeep
!notebooks/.gitkeep
!reports/.gitkeep
!docs/.gitkeep
